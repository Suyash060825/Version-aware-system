
# ==============================================================================
# Policy Ledger v2 — Environment Configuration Reference
# Copy to .env and configure appropriate values for your environment.
# ==============================================================================

# --- Flask & Application Security ---
FLASK_ENV=development                       # "development" | "production"
SECRET_KEY=change-this-to-a-strong-random-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-in-production
APP_NAME="Policy Ledger"
COMPANY_NAME="Acme Corp"

# --- LLM Backend Configuration ---
# Options: "cascade" (default) | "lmstudio" | "ollama" | "vllm" | "gemini" | "extractive"
LLM_BACKEND=lmstudio
LOCAL_LLM_MODEL=local-model

# Backend Endpoints
LMSTUDIO_BASE_URL=http://localhost:1234/v1
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY


# --- Databases & Vector Store ---
# Local SQLite default (Development):
# DATABASE_URL=sqlite:///data/ledger.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/policy_ledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=policy_ledger

# Redis URL (Celery task queue & caching)
REDIS_URL=redis://localhost:6379/0

# ChromaDB Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Default Admin Credentials ---
DEFAULT_ADMIN_EMAIL=admin@company.com
DEFAULT_ADMIN_PASSWORD=Admin@1234!
MFA_ISSUER=PolicyLedger

# --- File Upload Limits ---
MAX_CONTENT_LENGTH=33554432                  # 32 MB in bytes
