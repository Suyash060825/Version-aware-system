# ==============================================================================
# Policy Ledger Enterprise — Environment Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=production
FLASK_APP=wsgi.py
COMPANY_NAME=Acme Corporation

# Security & Session Secrets (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=<GENERATE_RANDOM_SECRET>
JWT_SECRET_KEY=<GENERATE_RANDOM_SECRET>
DEFAULT_ADMIN_PASSWORD=<SET_SECURE_PASSWORD>

# Database Connection (PostgreSQL 16 + pgvector)
# For local dev without Docker: sqlite:///instance/policy_ledger.db
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/policy_ledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<SET_SECURE_DATABASE_PASSWORD>
POSTGRES_DB=policy_ledger

# Redis 7 Cache & Celery Task Broker
REDIS_URL=redis://redis:6379/0

# Ingress Ports
HTTP_PORT=8080

# ==============================================================================
# AI, Embedding & Reranking Engine Configuration
# ==============================================================================

# LLM Backend: ollama | lmstudio | local | openai | mock
LLM_BACKEND=ollama
LOCAL_LLM_MODEL=qwen3:4b-q4_K_M
LOCAL_LLM_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://ollama:11434
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Embeddings: fastembed | sentence_transformers | mock
EMBEDDING_ENGINE=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Cross-Encoder Reranker: flashrank | cross_encoder | mock
RERANKER_ENGINE=flashrank
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
FLASHRANK_MODEL=ms-marco-TinyBERT-L-2-v2

# Multi-Tier Semantic Cache (0.0 to 1.0 similarity threshold)
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95

# ==============================================================================
# Enterprise Single Sign-On (SAML 2.0 / OIDC)
# ==============================================================================
SSO_ENABLED=false
SSO_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
SSO_OKTA_AUTH_URL=https://login.okta.com/oauth2/v1/authorize
SSO_AZURE_AUTH_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize

# ==============================================================================
# Telemetry & Observability
# ==============================================================================
# Optional OpenTelemetry Collector Endpoint (e.g., http://otel-collector:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_METRICS_ENABLED=true
