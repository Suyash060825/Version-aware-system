# === Knowledge Compiler ===
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# === Local Generation (Ollama — recommended) ===
LLM_BACKEND=ollama
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3:4b-q4_K_M
LOCAL_LLM_MAX_TOKENS=256
OLLAMA_NUM_GPU=99

# === Fact Extraction Mode ===
COMPILER_FACT_EXTRACTOR=spacy

# === Compiler settings ===
COMPILER_MIN_CHUNK_LENGTH=50
COMPILER_MAX_QUESTIONS_PER_CHUNK=5
COMPILER_ENTAILMENT_THRESHOLD=0.70
COMPILER_QA_ENABLED=true
COMPILER_FACTS_ENABLED=true

# === Legacy / Fallback ===
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
